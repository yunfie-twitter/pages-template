---
import { siteConfig } from "../site.config";

const hasAtMark = siteConfig.handle.startsWith("@");
const logoMark = hasAtMark ? "@" : "";
const logoWord = hasAtMark ? siteConfig.handle.slice(1) : siteConfig.handle;
---

<div class="loader" role="status" aria-label="サイトを読み込み中">
  <div class="loader-panels" aria-hidden="true">
    <div class="loader-panel" style="--p:0"></div>
    <div class="loader-panel" style="--p:1"></div>
    <div class="loader-panel" style="--p:2"></div>
    <div class="loader-panel" style="--p:3"></div>
    <div class="loader-panel" style="--p:4"></div>
  </div>
  <div class="loader-center" aria-hidden="true">
    <div class="loader-logo">
      {logoMark && <span class="loader-logo-mark">{logoMark}</span>}
      <span class="loader-logo-word">{logoWord}</span>
    </div>
  </div>
  <span class="sr-only">サイトを読み込み中です</span>
</div>

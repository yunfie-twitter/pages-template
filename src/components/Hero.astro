---
import { siteConfig } from "../site.config";

const { hero } = siteConfig;
---

<section id="home" class="hero">
  <div class="hero-content">
    <p class="hero-kicker">{hero.kicker}</p>
    <h1 class="hero-title">{hero.title}</h1>
    <p class="hero-copy">
      {hero.copy}
    </p>

    <div class="hero-actions">
      <a href={hero.primaryBtnHref} class="button hero-btn-primary">{hero.primaryBtnText}</a>
      <a href={hero.secondaryBtnHref} class="button button-ghost hero-btn-secondary">{hero.secondaryBtnText}</a>
    </div>
  </div>
</section>

---
import { siteConfig } from "../site.config";
import { withBase } from "../utils/paths";
import { profileLinks } from "../data/links";

const footerSocialLinks = profileLinks.slice(0, 4);
const logoWord = siteConfig.handle.startsWith("@")
  ? siteConfig.handle.slice(1)
  : siteConfig.author || siteConfig.siteName;
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="footer-logo" href={withBase("/")}>{logoWord}</a>
      <p>{siteConfig.footer.tagline}</p>
    </div>

    <nav class="footer-nav" aria-label="フッターナビゲーション">
      <a href={withBase("/#about")}>ABOUT</a>
      <a href={withBase("/#news")}>NEWS</a>
      <a href={withBase("/#music")}>MUSIC</a>
      <a href={withBase("/#repository")}>REPOSITORY</a>
      <a href={withBase("/#links")}>LINKS</a>
      <a href={withBase("/#contact")}>CONTACT</a>
      <a href={withBase("/blog/")}>BLOG</a>
      <a href={withBase("/privacy-policy/")}>PRIVACY</a>
    </nav>

    {footerSocialLinks.length > 0 && (
      <nav class="footer-social" aria-label="ソーシャルリンク">
        {footerSocialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer me"
            aria-label={link.label}
            style={`--accent: ${link.accent};`}
          >
            <img src={link.icon} alt="" loading="lazy" width="22" height="22" />
            <span>{link.name === "misskey.io" ? "Misskey" : link.name}</span>
          </a>
        ))}
      </nav>
    )}

    <div class="footer-bottom">
      <small>&copy; {siteConfig.footer.copyrightYear} {siteConfig.author}. All Rights Reserved.</small>
      <a class="footer-top" href="#home" aria-label="ページ上部へ戻る">TOP</a>
    </div>
  </div>
</footer>

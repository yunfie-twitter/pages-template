---
import { siteConfig } from "../site.config";

const { about, avatar, author } = siteConfig;
---

<section id="about" class="section">
  <div class="about-panel">
    <div class="about-heading">
      <span class="about-kicker">{about.kicker}</span>
      <h2>{about.title}</h2>
      <img
        class="about-icon"
        src={avatar}
        alt={`${author}のアバター`}
        width="180"
        height="180"
        loading="lazy"
      />
    </div>

    <div class="about-copy">
      <p class="about-lead">
        {about.lead}
      </p>

      <p>
        {about.bio}
      </p>

      <ul class="about-tags" aria-label="活動分野">
        {about.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

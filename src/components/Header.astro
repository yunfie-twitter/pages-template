---
import { profileLinks } from "../data/links";
import { getBlogPosts } from "../data/posts";
import { repositories } from "../data/repositories";
import { tracks } from "../data/tracks";
import { siteConfig } from "../site.config";
import { withBase } from "../utils/paths";

const { homeHref = "#home" } = Astro.props;
const normalizedHomeHref = homeHref.startsWith("/") ? withBase(homeHref) : homeHref;
const rootHref = withBase("/");
const sectionPrefix = normalizedHomeHref === "#home" ? "" : rootHref;

const posts = await getBlogPosts();
const hasNews = posts.length > 0;
const hasMusic = tracks.length > 0;
const hasRepository = repositories.length > 0;
const hasLinks = profileLinks.length > 0;
const hasContact = Boolean(siteConfig.contact.email && siteConfig.contact.email.trim() !== "");

const navItems = [
  { href: `${normalizedHomeHref}`, label: "TOP" },
  { href: `${sectionPrefix}#about`, label: "ABOUT" },
  ...(hasNews ? [{ href: `${sectionPrefix}#news`, label: "NEWS" }] : []),
  ...(hasMusic ? [{ href: `${sectionPrefix}#music`, label: "MUSIC" }] : []),
  ...(hasRepository ? [{ href: `${sectionPrefix}#repository`, label: "REPOSITORY" }] : []),
  ...(hasLinks ? [{ href: `${sectionPrefix}#links`, label: "LINKS" }] : []),
  ...(hasContact ? [{ href: `${sectionPrefix}#contact`, label: "CONTACT" }] : [])
];

const hasAtMark = siteConfig.handle.startsWith("@");
const logoMark = hasAtMark ? "@" : "";
const logoWord = hasAtMark ? siteConfig.handle.slice(1) : siteConfig.handle;
---

<header class="header">
  <div class="brand-lockup">
    <a class="logo" href={normalizedHomeHref} aria-label="トップページへ戻る">
      {logoMark && <span class="logo-mark" aria-hidden="true">{logoMark}</span>}
      <span class="logo-word">{logoWord}</span>
    </a>
  </div>

  <button
    class="menu-button"
    id="menuButton"
    type="button"
    aria-label="メニューを開く"
    aria-controls="navMenu"
    aria-expanded="false"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav class="nav" id="navMenu" aria-label="メインナビゲーション">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</header>

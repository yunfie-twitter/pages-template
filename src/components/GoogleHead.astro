---
import { siteConfig } from "../site.config";

const { googleAnalyticsId, googleSiteVerification } = siteConfig;
const hasGA = Boolean(googleAnalyticsId && googleAnalyticsId.trim() !== "");
const hasVerification = Boolean(googleSiteVerification && googleSiteVerification.trim() !== "");
---

{hasVerification && (
  <meta name="google-site-verification" content={googleSiteVerification} />
)}

{hasGA && (
  <>
    <!-- Google tag (gtag.js) - consent required before analytics collection -->
    <script is:inline define:vars={{ googleAnalyticsId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag() { window.dataLayer.push(arguments); };
      window.gtag("js", new Date());
      window.gtag("consent", "default", {
        analytics_storage: "denied",
        wait_for_update: 500,
      });
      window.gtag("config", googleAnalyticsId, { send_page_view: false });
    </script>
    <script
      type="text/partytown"
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
    />
  </>
)}

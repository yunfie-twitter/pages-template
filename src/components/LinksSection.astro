---
import { featuredLinkNames, type ProfileLink, profileLinks } from "../data/links";

const hasLinks = profileLinks.length > 0;
const featuredLinks = featuredLinkNames
  .map((name) => profileLinks.find((link) => link.name === name))
  .filter((link): link is ProfileLink => Boolean(link));

// featured に含まれていないもの、または featuredLinkNames に設定がない場合は残り
const moreLinks = profileLinks.filter((link) => !featuredLinks.includes(link));
// featuredLinks が空（設定にマッチしなかった）なら profileLinks の先頭4つを featured にする
const actualFeaturedLinks = featuredLinks.length > 0 ? featuredLinks : profileLinks.slice(0, 4);
const actualMoreLinks = featuredLinks.length > 0 ? moreLinks : profileLinks.slice(4);
---

{
  hasLinks && (
    <section id="links" class="section">
      <h2>LINKS</h2>
      <p>各種SNSや関連サービスへのリンクです。</p>

      <div class="link-grid">
        {actualFeaturedLinks.map((link) => (
          <a
            class="link-card"
            href={link.url}
            target="_blank"
            rel="noopener noreferrer me"
            aria-label={link.label}
            style={`--accent: ${link.accent};`}
          >
            <span class="link-mark" aria-hidden="true">
              <img src={link.icon} alt="" loading="lazy" width="28" height="28" />
            </span>
            <span class="link-name">{link.name}</span>
            <small class="link-kind">{link.kind}</small>
            <small class="link-url">{link.text}</small>
          </a>
        ))}

        {actualMoreLinks.map((link) => (
          <a
            class="link-card link-card-more"
            href={link.url}
            target="_blank"
            rel="noopener noreferrer me"
            aria-label={link.label}
            style={`--accent: ${link.accent};`}
            hidden
          >
            <span class="link-mark" aria-hidden="true">
              <img src={link.icon} alt="" loading="lazy" width="28" height="28" />
            </span>
            <span class="link-name">{link.name}</span>
            <small class="link-kind">{link.kind}</small>
            <small class="link-url">{link.text}</small>
          </a>
        ))}
      </div>

      {actualMoreLinks.length > 0 && (
        <button id="toggleLinks" class="button links-toggle" type="button" aria-expanded="false">
          続きを表示
        </button>
      )}
    </section>
  )
}
